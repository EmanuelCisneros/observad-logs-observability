# Copy to .env and adjust for your environment.
# Never commit .env to version control.

OBSERVA_HTTP_ADDR=:8080
OBSERVA_LOG_LEVEL=info
OBSERVA_INGEST_API_KEY=change-me-in-production

OBSERVA_CH_ADDR=127.0.0.1:9000
OBSERVA_CH_DB=observa
OBSERVA_CH_USER=default
OBSERVA_CH_PASSWORD=

OBSERVA_REDIS_ADDR=127.0.0.1:6379
OBSERVA_REDIS_PASSWORD=
OBSERVA_REDIS_DB=0
OBSERVA_REDIS_STREAM=observa:ingest

OBSERVA_BATCH_SIZE=10000
OBSERVA_FLUSH_INTERVAL=1s
OBSERVA_WORKERS=4
OBSERVA_RETENTION=720h
OBSERVA_CORS_ORIGINS=http://localhost:3000,*
OBSERVA_INGEST_RATE_LIMIT=1000

# Set to 1 during development if ClickHouse is not running.
# The in-memory store does NOT persist across restarts.
# OBSERVA_ALLOW_MEMSTORE=1
